; Bidirectional DShot300 TX / eRPM RX. Adapted from pio-dshot (MIT)
; Copyright (c) 2023 Simon Wunderlich.
; Reference: https://github.com/simonwunderlich/pio-dshot
; The pin is idle HIGH; outgoing DShot is inverted, and so is the CRC nibble.
; Clock is 40 PIO cycles per TX bit (DShot300 => 12 MHz PIO clock).
.program dshot_tx
.wrap_target
    set pindirs, 1
    pull
    set x, 15
tx_loop:
    set pins, 0 [14]
    out pins, 1 [14]
    set pins, 1 [8]
    jmp x-- tx_loop

    ; Fixed turnaround delay (~25 microseconds) sent by host.
    pull
    mov x, osr
after_tx:
    jmp x-- after_tx

    ; Release the pin and capture 21 NRZI telemetry bits.
    set pindirs, 0
    set x, 31
wait_rx:
    jmp !x finish_rx
    jmp x-- check_rx_pin
check_rx_pin:
    jmp pin wait_rx
start_rx:
    set x, 20 [8]
rx_loop:
    in pins, 1 [30]
    jmp x-- rx_loop
finish_rx:
    push
    set pindirs, 1
    set pins, 1 [2]
.wrap
