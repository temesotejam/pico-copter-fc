; One-way DShot300. Each bit is 8 PIO cycles at 2.4 MHz = 3.333 us.
; '0' high 3/8 = 1.25 us; '1' high 6/8 = 2.50 us.
; The TX FIFO autopulls exactly 16 bits, MSB first. On an empty FIFO,
; OUT stalls with sideset=0, keeping the ESC line LOW between frames.
.program dshot_tx
.side_set 1
.wrap_target
bitloop:
    out x, 1        side 0 [1] ; 2 cycles
    jmp !x bit_zero     side 1 [2] ; 3 cycles
    jmp bitloop     side 1 [2] ; 3 cycles; 1: 6 high / 8 total
bit_zero:
    nop             side 0 [2] ; 3 cycles; 0: 3 high / 8 total
.wrap
